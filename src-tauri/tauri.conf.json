{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "uragami",
  "version": "0.1.0",
  "identifier": "com.uragami.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "uragami",
        "width": 720,
        "height": 520,
        "minWidth": 400,
        "minHeight": 300,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
